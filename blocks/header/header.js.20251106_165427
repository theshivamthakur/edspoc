const TEMPLATE_VAR_NAME = '{{app-name}}';

// media query match that indicates mobile width
const isDesktop = window.matchMedia('(min-width: 992px)');

function closeOnEscape(e) {
  if (e.code === 'Escape') {
    const submenuContainer = document.querySelector('.header-submenu-container');
    submenuContainer.classList.remove('header-active');
    document.querySelector('body').classList.remove('header-overflow-hidden');
    document.removeEventListener('keydown', closeOnEscape);
  }
}

function handleMenuExpanded() {
  const submenuContainer = document.querySelector('.header-submenu-container');
  submenuContainer.classList.toggle('header-active');
  document.querySelector('body').classList.toggle('header-overflow-hidden');
  if (submenuContainer.classList.contains('header-active')) {
    document.addEventListener('keydown', closeOnEscape);
  } else {
    document.removeEventListener('keydown', closeOnEscape);
  }
}

function handleMenu(block) {
  const [hamburgerIcon, , , loginLink] = block.children;
  const hamburgerDiv = hamburgerIcon.querySelector('div');
  hamburgerDiv.classList.add('header-d-flex', 'header-align-items-center');
  const hamburger = document.createElement('div');
  hamburger.innerHTML = hamburgerDiv.innerHTML;
  hamburger.classList.add('header-hamburger', 'header-analytics_cta_click');
  hamburger.setAttribute('data-cta-label', 'hamburger-menu');
  hamburger.addEventListener('click', handleMenuExpanded);
  hamburgerDiv.replaceWith(hamburger);

  const loginBtnWrapper = loginLink.querySelector('div');
  loginBtnWrapper.classList.add('header__login-btn-wrapper', 'header-analytics_cta_click');
  loginBtnWrapper.setAttribute('data-cta-label', 'login-btn');
  const loginBtn = document.createElement('button');
  loginBtn.classList.add('header__login-btn', 'header-btn', 'header-text-boing-primary', 'header-bg-transparent', 'header-fw-semibold', 'header-rounded-4', 'header-btn-sm', 'header-py-3', 'header-px-4');
  loginBtn.textContent = loginLink.textContent.trim();
  loginBtnWrapper.innerHTML = '';
  loginBtnWrapper.append(loginBtn);
  loginLink.replaceWith(loginBtnWrapper);
}

function handleBoingLogo(block) {
  const [, boingLogo] = block.children;
  const boingLogoContent = boingLogo.querySelector('div');
  boingLogoContent.classList.add('header-d-flex', 'header-justify-content-center', 'header-w-25');
  const link = boingLogoContent.querySelector('a');
  link.classList.add('header-analytics_cta_click');
  link.setAttribute('data-ct', '');
  link.setAttribute('a-label', 'header-logo-boing');
  const logoDiv = document.createElement('div');
  logoDiv.classList.add('header__logo', 'header-d-flex', 'header-align-items-center');
  const img = boingLogoContent.querySelector('img');
  img.classList.add('header__logo-img');
  logoDiv.append(img);
  link.append(logoDiv);
  boingLogoContent.innerHTML = '';
  boingLogoContent.append(link);
  boingLogo.replaceWith(boingLogoContent);
}

function handleSidebarMenuItems(block) {
  const [, , , , ...rest] = block.children;
  const menuItems = rest.slice(0, rest.length - 1);
  const sidebar = document.querySelector('.header-sidebar');
  const ul = document.createElement('ul');
  ul.classList.add('header-sidebar__menu', 'header-list-unstyled', 'header-px-4');

  menuItems.forEach((item) => {
    const li = document.createElement('li');
    li.classList.add('header-sidebar__menu-item', 'header-py-6', 'header-border-bottom', 'header-border-boing-neutral-gray-200');
    const link = item.querySelector('a');
    link.classList.add('header-sidebar__menu-link', 'header-d-flex', 'header-align-items-center', 'header-text-decoration-none', 'header-px-6', 'header-fw-medium', 'header-analytics_cta_click');
    link.setAttribute('data-link', link.getAttribute('href'));
    const img = item.querySelector('img');
    img.classList.add('header-sidebar__menu-icon', 'header-me-4');
    img.setAttribute('loading', 'lazy');
    link.prepend(img);
    li.append(link);
    ul.append(li);
  });
  sidebar.prepend(ul);
}

