export default async function decorate(block) {
  const appName = block.children[0].textContent.trim();
  const section = document.createElement('section');
  section.classList.add('header-position-relative', 'header-mb-15');
  const appNameSpan = document.createElement('span');
  appNameSpan.classList.add('header-d-none', 'header-app-name');
  appNameSpan.setAttribute('data-app-name', appName);
  appNameSpan.textContent = appName;
  section.append(appNameSpan);

  const header = document.createElement('header');
  header.classList.add('header-boing-container', 'header-d-flex', 'header-justify-content-between', 'header-align-items-center', 'header-h-15', 'header-px-5', 'header-py-2', 'header-fixed-top', 'header-w-100', 'header-bg-white');
  section.append(header);

  const leftDiv = document.createElement('div');
  leftDiv.classList.add('header-d-flex', 'header-w-25');
  header.append(leftDiv);

  const centerDiv = document.createElement('div');
  header.append(centerDiv);

  const rightDiv = document.createElement('div');
  rightDiv.classList.add('header-d-flex', 'header-w-25', 'header-justify-content-end');
  header.append(rightDiv);

  const submenuContainer = document.createElement('div');
  submenuContainer.classList.add('header-submenu-container', 'header-position-fixed', 'header-top-0', 'header-start-0', 'header-end-0', 'header-m-auto', 'header-overflow-hidden');

  const sidebar = document.createElement('aside');
  sidebar.classList.add('header-sidebar', 'header-start-0', 'header-bg-white', 'header-position-absolute');
  submenuContainer.append(sidebar);

  const sidebarCurve = document.createElement('div');
  sidebarCurve.classList.add('header-sidebar__curve');
  sidebar.append(sidebarCurve);

  const overlay = document.createElement('div');
  overlay.classList.add('header-overlay', 'header-position-absolute', 'header-top-0', 'header-start-0', 'header-w-100', 'header-h-100', 'header-bg-black', 'header-opacity-25');
  overlay.addEventListener('click', handleMenuExpanded);
  submenuContainer.append(overlay);
  section.append(submenuContainer);

  block.textContent = '';
  block.append(section);

  handleMenu(block);
  handleBoingLogo(block);
  handleSidebarMenuItems(block);
  handleFooterBrand(block);

  const [hamburgerIcon, boingLogo, loginLink] = block.children;
  leftDiv.append(hamburgerIcon);
  centerDiv.append(boingLogo);
  rightDiv.append(loginLink);

  decorateButtons(block);
  decorateIcons(block);

  const headerEl = block.querySelector('.header-boing-container');
  const hamburger = headerEl.querySelector('.header-hamburger');
  const loginBtnWrapper = headerEl.querySelector('.header__login-btn-wrapper');

  // Check if the user is logged in
  const accessToken = localStorage.getItem('accessToken');
  if (accessToken) {
    loginBtnWrapper.style.display = 'none';
    const logoutMenuItem = block.querySelector('.header__menu-item--logout');
    if (logoutMenuItem) {
      logoutMenuItem.style.display = 'block';
    }
  }

  // For desktop, remove hamburger and sidebar
  const handleDesktopChange = (e) => {
    if (e.matches) {
      hamburger.remove();
      sidebar.remove();
      overlay.remove();
      submenuContainer.remove();
    } else {
      // Re-add hamburger, sidebar, overlay for mobile if they don't exist
      if (!headerEl.querySelector('.header-hamburger')) {
        leftDiv.prepend(hamburger);
      }
      if (!submenuContainer.querySelector('.header-sidebar')) {
        submenuContainer.prepend(sidebar);
      }
      if (!submenuContainer.querySelector('.header-overlay')) {
        submenuContainer.append(overlay);
      }
      if (!section.querySelector('.header-submenu-container')) {
        section.append(submenuContainer);
      }
    }
  };

  isDesktop.addEventListener('change', handleDesktopChange);
  handleDesktopChange(isDesktop);
}
